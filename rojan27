<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XYR</title>

<style>
:root{
    color-scheme: light dark;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:Canvas;
    color:CanvasText;
    font-family:Inter,system-ui,sans-serif;
}

.logo{
    display:flex;
    align-items:center;
    gap:.08em;
    cursor:default;
}

.xy{
    font-size:clamp(5rem,18vw,12rem);
    font-weight:900;
    letter-spacing:-0.12em;
    color:inherit;
}

.r{
    font-size:clamp(5rem,18vw,12rem);
    font-weight:900;
    color:inherit;
    opacity:.55;
    animation:blink 2s infinite;
}

@keyframes blink{
    0%,45%,100%{
        opacity:.55;
    }
    50%{
        opacity:1;
    }
}

.logo:hover .r{
    opacity:1;
}
</style>
</head>
<body>

<div class="logo">
    <div class="xy">XY</div>
    <div class="r">R</div>
</div>

</body>
</html>
